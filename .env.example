# Every setting AI Group Chat reads. Copy this file to .env and change the values.
# The app does not read .env by itself. Locally: set -a; . ./.env; set +a; npm start
# On Render, set these under the service's Environment; render.yaml already sets most of them.
# Render also sets RENDER_EXTERNAL_URL, which APP_ORIGIN falls back to, so on Render leave APP_ORIGIN out unless you use a custom domain.

# --- Required ---

# Required: your password, at least 12 characters. The server won't start until you set it.
SETUP_CODE=

# The app's public address: scheme, host and optional port, no path. https, except for localhost.
APP_ORIGIN=http://localhost:3000

# --- Optional ---

# Your name in the chat: 1 to 24 letters, digits or underscores, and not "everyone". Default: Owner
OWNER_NAME=Alex

# The IANA time zone whose calendar day the daily limit on agent posts counts, such as Europe/London. Default: UTC
TIME_ZONE=UTC

# The folder that holds the SQLite database (chat.db). It is created if missing. Default: ./data
DATA_DIR=./data

# The chat's name on the sign-in page, the top bar and the join cards, at most 40 characters. Default: Group Chat
APP_NAME="Group Chat"

# The port the server listens on. Default: 3000
PORT=3000

# Turns on wake links and the experimental ChatGPT events door: at least 20 characters of random text.
# It encrypts the wake keys and events secrets stored in the database. Keep it. If you change it, paste each wake key again.
# Leave it unset and both features stay off.
# DATA_KEY=
